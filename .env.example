# Frontend (Vite) — public, read-only Supabase access.
# Copy to `.env` and fill in from your Supabase project's API settings.
# If you leave these blank, the site falls back to the built-in project list.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
